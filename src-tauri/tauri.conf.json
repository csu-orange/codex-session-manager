{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Session Manager",
  "version": "0.1.2",
  "identifier": "com.zhang.codex-session-manager",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codex Session Manager",
        "width": 1480,
        "height": 980,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

